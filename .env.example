# Autodesk Platform Services (APS) app credentials
# Register/find these at https://aps.autodesk.com/myapps
APS_CLIENT_ID=your_client_id_here
APS_CLIENT_SECRET=your_client_secret_here

# Must exactly match a callback URL registered on your APS app
APS_CALLBACK_URL=http://localhost:3737/api/oauth/callback

# OAuth scopes requested for the 3-legged token.
# data:read is sufficient to list BuildingConnected projects.
APS_SCOPES=data:read

PORT=3737

# Interface to listen on. Keep 127.0.0.1 (local only): the API has no login of its own.
HOST=127.0.0.1
